import os
import sys
from decimal import Decimal

sys.path.insert(0, os.getcwd())
os.environ.setdefault('DJANGO_SETTINGS_MODULE', 'core.settings')
import django
django.setup()

from clientes.models import Cliente
from productos.models import Categoria, Producto
from proveedores.models import Proveedor
from ventas.models import DetalleVenta, Pedido, Venta

cat, _ = Categoria.objects.get_or_create(nombre='Electronica')

prov1, _ = Proveedor.objects.get_or_create(
    correo='ventas@techmx.com', defaults={'nombre': 'TechMX'})
prov2, _ = Proveedor.objects.get_or_create(
    correo='contacto@distcelaya.com', defaults={'nombre': 'Distribuidora Celaya'})

cli1, _ = Cliente.objects.get_or_create(
    correo='juan@utec.com', defaults={'nombre': 'Juan Perez'})
cli2, _ = Cliente.objects.get_or_create(
    correo='maria@utec.com', defaults={'nombre': 'Maria Lopez'})

prod, _ = Producto.objects.get_or_create(
    nombre='Laptop HP',
    defaults={'precio': Decimal('12500.00'), 'stock': 5,
              'categoria': cat, 'proveedor': prov1})

if not Venta.objects.exists():
    venta = Venta.objects.create(cliente=cli1)
    DetalleVenta.objects.create(
        venta=venta, producto=prod, cantidad=2,
        precio_unitario=Decimal('12500.00'))
    print('Venta creada, total:', venta.total)

Pedido.objects.get_or_create(
    numero_pedido='PED-2026-0001',
    defaults={'cliente': cli2, 'estado': 'pendiente'})

print('Categorias:', Categoria.objects.count())
print('Proveedores:', Proveedor.objects.count())
print('Clientes:', Cliente.objects.count())
print('Productos:', Producto.objects.count())
print('Ventas:', Venta.objects.count())
print('Pedidos:', Pedido.objects.count())